{
  "name": "@wms/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "db:migrate": "pnpm --filter @wms/db db:migrate",
    "db:rollback": "pnpm --filter @wms/db db:rollback",
    "infra:smoke": "node scripts/compose-smoke.mjs",
    "test:int": "vitest run -c vitest.int.config.ts",
    "test:e2e": "playwright test",
    "test:int:neon": "WMS_INT_TARGET=neon vitest run -c vitest.int.config.ts",
    "spike:neon": "node scripts/neon-spike.mjs",
    "test:ac": "node scripts/test-ac/cli.mjs",
    "check:scope": "node scripts/guards/cli.mjs scope",
    "check:tests": "node scripts/guards/cli.mjs tests",
    "check:ac-ratchet": "node scripts/guards/cli.mjs ac-ratchet",
    "check:protected": "node scripts/guards/cli.mjs protected",
    "check:assertions": "node scripts/guards/cli.mjs assertions",
    "check:pilot": "node scripts/guards/cli.mjs pilot",
    "check:all": "node scripts/guards/cli.mjs all",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
