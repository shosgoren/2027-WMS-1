# Etkin WMS — yerel geliştirme ortam değişkenleri (docker compose).
# Kullanım: cp .env.example .env
# Buradaki değerler YALNIZCA yerel yer tutucudur. Gerçek değerler (Neon, staging, prod)
# yalnızca .env (git'e girmez) veya CI/GitHub sırlarında tutulur (G-09).
# Neon'da aynı değişken adları kullanılır; rol karşılıkları Q-06 / T-005d ile kesinleşir.

# docker compose proje adı (konteyner/ağ/volume öneki).
COMPOSE_PROJECT_NAME=etkin-wms

# --- PostgreSQL ---
# Yerel/CI'da migration rolü = konteyner bootstrap kullanıcısı (tablo sahibi).
POSTGRES_USER=wms_migrator
POSTGRES_PASSWORD=local-placeholder-migrator
POSTGRES_DB=wms
# Uygulama rolü wms_app'in parolası; yalnızca infra/postgres/init/01-roles.sh kullanır. PgBouncer userlist'i
# açık metin değil SCRAM verifier içerir (T-101c): pgbouncer-userlist servisi verifier'ı pg_authid'den kopyalar.
WMS_APP_PASSWORD=local-placeholder-app
# Kimlik rolü wms_auth'un parolası (ADR-014 §10); yalnızca 01-roles.sh kullanır (PgBouncer userlist'te SCRAM verifier, T-101c).
WMS_AUTH_PASSWORD=local-placeholder-auth

# Uygulama → PgBouncer (transaction mode), rol wms_app. Parola WMS_APP_PASSWORD ile aynı olmalı.
DATABASE_URL=postgresql://wms_app:local-placeholder-app@localhost:6432/wms
# Kimlik (Better Auth) → PgBouncer, rol wms_auth. Parola WMS_AUTH_PASSWORD ile aynı olmalı.
AUTH_DATABASE_URL=postgresql://wms_auth:local-placeholder-auth@localhost:6432/wms
# Migration / doğrudan bağlantı → PostgreSQL, rol wms_migrator. Parola POSTGRES_PASSWORD ile aynı olmalı.
DATABASE_URL_DIRECT=postgresql://wms_migrator:local-placeholder-migrator@localhost:5432/wms

# --- PgBouncer (yalnızca yerel/CI) ---
# Yönetim konsolu (SHOW CONFIG) kullanıcısı pgbouncer_admin'in parolası; yalnızca PgBouncer'da tanımlıdır.
# Userlist'e SCRAM verifier olarak yazılır; çift tırnak içeremez.
PGBOUNCER_ADMIN_PASSWORD=local-placeholder-pgbouncer-admin
# Kullanıcı/veritabanı çifti başına sunucu bağlantısı; AC-05 için 1–2'ye düşürülür.
PGBOUNCER_DEFAULT_POOL_SIZE=20
# Q-02/Q-04 ile eşitlenecek; 1000 = Neon belgesindeki Neon PgBouncer değeri. 0 = protokol düzeyi prepared statement kapalı.
PGBOUNCER_MAX_PREPARED_STATEMENTS=1000

# --- MinIO (S3 uyumlu, ADR-006) ---
MINIO_ROOT_USER=local-placeholder-minio
MINIO_ROOT_PASSWORD=local-placeholder-minio-secret
# Özel (private) bucket adı.
S3_BUCKET=wms-local-private

# --- Ana makine portları (yalnızca 127.0.0.1'e bağlanır) ---
POSTGRES_HOST_PORT=5432
PGBOUNCER_HOST_PORT=6432
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
